# Este es un ejemplo de variables de entorno para el backend.
# Copialo como .env y completá los valores reales de tu entorno.
# Fijate que si no usás Brevo, podés dejar BREVO_API_KEY vacía.

# Host de MySQL (por ejemplo: 127.0.0.1, localhost o nombre del contenedor)
DB_HOST=127.0.0.1

# Puerto de MySQL
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=gastos_personales

# Usuario de MySQL
DB_USER=tu_usuario

# Contraseña de MySQL
DB_PASS=tu_contraseña

# Origen permitido para CORS (en desarrollo suele usarse *)
CORS_ALLOW_ORIGIN=*

# Cantidad de horas que dura el token de sesión
TOKEN_EXPIRATION_HOURS=24

# API Key de Brevo (opcional). Si está vacía, no se envían emails.
BREVO_API_KEY=

# Datos del remitente para Brevo
BREVO_FROM_EMAIL=no-reply@tudominio.com
BREVO_FROM_NAME=Gastos Personales
